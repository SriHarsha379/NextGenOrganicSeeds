server {
    listen 80;
    server_name hasaorganicseeds.com www.hasaorganicseeds.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name hasaorganicseeds.com www.hasaorganicseeds.com;

    root /var/www/NextGenOrganicSeeds;
    index index.html index.htm;

    # Correct SSL configuration
    ssl_certificate /etc/letsencrypt/live/hasaorganicseeds.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hasaorganicseeds.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Handle Django requests
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Serve static files
    location /static/ {
        alias /home/seedstore/static/;
        autoindex on;
    }

    # Serve media files
    location /media/ {
        alias /var/www/nextgenorganicseeds/media/;
        autoindex on;
    }

    error_log /var/log/nginx/hasaorganicseeds_error.log;
    access_log /var/log/nginx/hasaorganicseeds_access.log;
}
