# Copy this file to .env and fill in your real values.
# Never commit .env to version control.

# ─── PhonePe Payment Gateway ────────────────────────────────────────────────
# Get these from the PhonePe Business Dashboard → API Keys
PHONEPE_CLIENT_ID=SU2506221550217309297772
PHONEPE_CLIENT_SECRET=8d093e74-a731-4f72-995f-2227fdc4c58f
PHONEPE_CLIENT_VERSION=1
# Use SANDBOX for testing, PRODUCTION for live
PHONEPE_ENV=PRODUCTION

# ─── PhonePe Webhook Auth (optional but recommended) ────────────────────────
# Set a username + password in the PhonePe dashboard under Webhook Settings,
# then mirror those values here.  Leave blank to skip verification (less secure).
PHONEPE_WEBHOOK_USER=olivia19
PHONEPE_WEBHOOK_PASSWORD=olivia123

# ─── Django ─────────────────────────────────────────────────────────────────
DEBUG=False
# The public URL of this deployment — used in email links (unsubscribe, abandoned cart).
SITE_URL=https://hasafarm.com

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL strongly recommended for production. Leave blank to use SQLite.
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# DATABASE_URL=postgres://seedstore:yourpassword@localhost:5432/seedstore

# ─── Error tracking (Sentry) ─────────────────────────────────────────────────
# Get your DSN from sentry.io → Project Settings → Client Keys.
# Leave blank to disable — the app works fine without it.
SENTRY_DSN=

# ─── HSTS Preload (irreversible — read before enabling) ──────────────────────
# Only set to True when you are 100% sure this domain will ALWAYS serve HTTPS.
# Once submitted to the browser preload list it can take months to remove.
HSTS_PRELOAD=False
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your_django_secret_key_here

# ─── Email (SMTP via Hostinger) ──────────────────────────────────────────────
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=contact@hasafarm.com
EMAIL_HOST_PASSWORD=!gkxhq0E@
DEFAULT_FROM_EMAIL=Your Store Name <your_email@yourdomain.com>
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com
